#!/usr/bin/env bash
# pi-search: search and read pi (coding agent) session history
set -euo pipefail

VERSION="1.2.0"
COL=pi-history
MD="$HOME/.pi/agent/sessions-md"
SELF="$(basename "$0")"
BIN="$(cd "$(dirname "$0")" && pwd)/$SELF"
printf -v ESC_BIN '%q' "$BIN"
EXPORT="$(dirname "$BIN")/pi-export-history"
[ -x "$EXPORT" ] || EXPORT="$(command -v pi-export-history || echo "$HOME/.local/bin/pi-export-history")"

usage() {
  cat <<EOF
$SELF — search and read pi session history

Sessions are stored by pi as JSONL under ~/.pi/agent/sessions/ and exported to
readable markdown (by pi-export-history) for fast local search.

USAGE
  $SELF [flags] <query>        keyword search (ripgrep, milliseconds)
  $SELF -v [flags] <query>     semantic search (qmd embeddings; slower)
  $SELF show <file> [line] [query]
                               open a transcript in nvim (read-only), centered
                               on <line> with [query] highlighted; bat if piped
  $SELF resume <file>          resume the pi session for this transcript
                               (cd to the session's cwd and run \`pi --session\`)
  $SELF export [-t]            (re)export sessions to markdown
  $SELF -v --reindex <query>   rebuild the semantic index, then search
  $SELF --help | --version

SEARCH FLAGS
  -n <N>        show top N matches (default 20)
  --all         show every match
  -t, --tool-results
                include tool results — by default only user and assistant
                messages are searched, i.e. what you see in pi
                (keyword search only; the semantic index is always lean)
  -d, --distinct
                one row per session (its strongest match) instead of every hit
  -p, --parents-only
                only your own sessions; exclude delegated subagent runs
  -v            semantic search over the lean corpus; only meaningful results
                for vague queries like "that caching argument"

EXAMPLES
  $SELF "redis timeout"              find where an error was discussed
  $SELF -n 20 --all refactor         everything mentioning refactor
  $SELF -t "stack trace"             also match tool/output text
  $SELF -d "redis timeout"           one row per session
  $SELF -p "redis"                   exclude subagent sessions
  $SELF -v -d "that caching argument" distinct semantic matches
  $SELF -v "that caching argument"   when you don't know the words

KEYS (fzf picker)
  enter   resume the selected session in pi          esc  cancel
  ctrl-o  open in PI_SEARCH_EDITOR if set, otherwise the match-aware viewer
  ctrl-t  copy the transcript file to the clipboard (pastes as a file)
  ctrl-x  copy the transcript path to the clipboard
  ctrl-r  refresh the semantic index (semantic mode)
  ctrl-/  show or hide the preview pane (full-width list)
  type to narrow further (fuzzy)                      mouse wheel / shift+↓  scroll preview

KEYS (nvim transcript)
  n / N   next / previous highlighted match           q  quit (or :q)
EOF
}

# rel_age "2026-09-16T01-13-47" (UTC) → "1h ago" | exact date once older than a week
rel_age() {
  local d="${1:0:10}" t="${1:11:2}:${1:14:2}:${1:17:2}" epoch
  epoch=$(date -u -d "$d $t" +%s 2>/dev/null || date -u -j -f "%Y-%m-%dT%H:%M:%S" "${d}T${t}" +%s 2>/dev/null) || { echo "$d"; return; }
  epoch_age "$epoch" "$d"
}

# epoch_age <epoch> <label>: relative age, or <label> once older than a week
epoch_age() {
  local age=$(( $(date +%s) - $1 ))
  (( age < 0 )) && age=0
  if (( age < 60 )); then echo "${age}s ago"
  elif (( age < 3600 )); then echo "$((age / 60))m ago"
  elif (( age < 86400 )); then echo "$((age / 3600))h ago"
  elif (( age < 604800 )); then echo "$((age / 86400))d ago"
  else echo "$2"
  fi
}

# row_age <path relative to MD>: stamp in the name, else the source session's mtime
row_age() {
  local ts m label source="$HOME/.pi/agent/sessions/${1%.md}.jsonl"
  ts=$(echo "$1" | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}' | head -n1) || true
  if [ -n "$ts" ]; then rel_age "$ts"; return; fi
  [ -f "$source" ] || source="$MD/$1"
  m=$(stat -c %Y "$source" 2>/dev/null || stat -f %m "$source" 2>/dev/null) || return 0
  label=$(date -d "@$m" +%Y-%m-%d 2>/dev/null || date -r "$m" +%Y-%m-%d)
  epoch_age "$m" "$label"
}

# row labelizer: stdin "path<TAB>line<TAB>age<TAB>text" (4 columns)
#   fixed=1 → rank decided upstream (qmd score); else strength = query occurrences
labelize() {  # $3: label for the home dir (path with / swapped for -)
  awk -F'\t' -v fixed="${1:-0}" -v q="$(echo "${2:-}" | tr '[:upper:]' '[:lower:]')" \
      -v hl="${3:-}" -v parents_only="${4:-0}" -v rank="${5:-0}" '
    { p=$1; l=$2; t=$4; gsub(/\t/, " ", t)
      r=p
      if (r ~ /-Code-/) { sub(/^.*-Code-/, "", r); sub(/--\/.*/, "", r) }
      else { sub(/--\/.*/, "", r); r=(r==hl) ? "~" : r }
      if (r=="") r="session"
      sub(/^zendesk-/, "", r); if (length(r) > 18) r=substr(r, 1, 17) "~"
      kind=(p ~ /\/subagent-artifacts\/|\/run-[0-9]+\//) ? "s" : "a"
      if (parents_only && kind=="s") next
      c=0
      if (!fixed) { s=tolower(t)
        while ((i=index(s,q))) { c++; s=substr(s,i+length(q)) } }
      hits=fixed ? "" : c "x"
      lab=sprintf("\033[36m%-18s\033[0m \033[2m%-10s\033[0m \033[%sm%s\033[0m \033[33m%-3s\033[0m", \
                  r, $3, (kind=="s" ? "33" : "2"), kind, hits)
      if (!fixed) t=sprintf("%4s: %s", l, t)
      printf "%04d:%06d%06d:%s %s\t%s\t%s\n", 9999-c, rank, NR, lab, t, p, l }'
}

# distinct_rows: first (strongest) row per session file; input must be pre-sorted
distinct_rows() { awk -F'\t' '!seen[$2]++'; }

# copy_file <file>: put the file itself on the macOS clipboard
copy_file() {
  osascript -e 'on run argv' -e 'set the clipboard to (POSIX file (item 1 of argv))' -e 'end run' "$1"
}

# clears the header ~3s later through fzf's --listen port (FZF_PORT)
CLEAR="execute-silent[(sleep 3; curl -s -XPOST localhost:\$FZF_PORT -d 'change-header()') >/dev/null 2>&1 &]"

fzf_pick() { # $1=rows  $2=query  $3=footer  $4=extra bind  $5=prompt
  local rows="$1" q="$2" footer="$3" bind="${4:-}" prompt="${5:-sessions}" sel key f l escmd
  printf -v escmd '%q' "$MD/"
  if ! command -v fzf >/dev/null || ! [ -t 0 ]; then
    printf '%s\n' "$rows"; exit 0
  fi
  sel=$(fzf --ansi --prompt="$prompt> " --height=90% --reverse --border=rounded \
        --delimiter=$'\t' --with-nth=1 --preview-window="right:55%" \
        --expect=ctrl-o \
        --bind='ctrl-/:toggle-preview' \
        --listen \
        --color="header:italic,label:blue" \
        --border-label="$footer" --border-label-pos=0:bottom \
        ${bind:+--bind="$bind"} \
        --bind="ctrl-t:transform($ESC_BIN copy $escmd{2} >/dev/null 2>&1 && echo 'change-header(✓ file copied to clipboard)' || echo 'change-header(copy failed)')+$CLEAR" \
        --bind="ctrl-x:transform($ESC_BIN copy-path $escmd{2} >/dev/null 2>&1 && echo 'change-header(✓ path copied to clipboard)' || echo 'change-header(copy failed)')+$CLEAR" \
        --preview="$ESC_BIN --preview $escmd{2} {3}" \
        <<< "$rows") || exit 0
  key=$(head -n1 <<< "$sel"); sel=$(sed '1d' <<< "$sel")
  [ -n "$sel" ] || exit 0
  IFS=$'\t' read -r _ f l _ <<< "$sel"
  f="$MD/$f"
  [ -f "$f" ] || { echo "no transcript: $f" >&2; exit 1; }
  if [ "$key" != ctrl-o ]; then exec "$BIN" resume "$f"; fi
  if [ -n "${PI_SEARCH_EDITOR:-}" ]; then
    local -a ed; read -ra ed <<< "$PI_SEARCH_EDITOR"
    exec "${ed[@]}" "$f"
  fi
  exec "$BIN" show "$f" "$l" "$q"
}

# parse search flags anywhere in the args; non-flag args go to REST[]
parse_flags() {
  N=20; ALL=0; TR=0; DISTINCT=0; PARENTS_ONLY=0
  REST=()
  while [ $# -gt 0 ]; do
    case "$1" in
      -n) N="$2"; shift 2 ;;
      --all) ALL=1; shift ;;
      -t|--tool-results) TR=1; shift ;;
      -d|--distinct) DISTINCT=1; shift ;;
      -p|--parents-only) PARENTS_ONLY=1; shift ;;
      *) REST+=("$1"); shift ;;
    esac
  done
}

# semantic rows: semantic_rows <q> [-n N | --all] [--distinct] [--parents-only] [--refresh]
#   --refresh re-exports and rebuilds the qmd index first (slow)
semantic_rows() {
  local q="$1"; shift
  local refresh="" distinct="" parents_only=0 n=20 all=0
  local -a limitargs=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --refresh) refresh=1 ;;
      --distinct) distinct=1 ;;
      -p|--parents-only) parents_only=1 ;;
      -n) n="$2"; shift ;;
      --all) all=1 ;;
    esac
    shift
  done
  if [ $all = 1 ] || [ -n "$distinct" ] || [ $parents_only = 1 ]; then limitargs=(--all); else limitargs=(-n "$n"); fi
  [ $all = 1 ] && n=999999
  [ -n "$refresh" ] && { "$EXPORT" >/dev/null; qmd update -c "$COL" >/dev/null; qmd embed -c "$COL" >&2; }
  qmd vsearch "$q" -c "$COL" ${limitargs[@]+"${limitargs[@]}"} --json 2>/dev/null \
    | jq -r '.[] |
        (.file | sub("^qmd://pi-history/";"")) as $f |
        (.score * 100 | round) as $pct |
        (if $pct < 40 then 33 elif $pct < 70 then 208 else 196 end) as $c |
        "\($f)\t\(.line)\t-\t\u001b[38;5;\($c)m\($pct)%\u001b[0m  " +
        (.snippet | gsub("@@[^@]*@@ *"; "") |
         gsub("\\([0-9]+ before, [0-9]+ after\\) *"; "") |
         gsub("\\s+"; " ") | .[0:110])' \
    | while IFS=$'\t' read -r f l _ rest; do printf '%s\t%s\t%s\t%s\n' "$f" "$l" "$(row_age "$f")" "$rest"; done \
    | labelize 1 "$q" "-$(printf %s "$HOME" | sed 's|/|-|g')" "$parents_only" \
    | LC_ALL=C sort \
    | { [ -n "$distinct" ] && distinct_rows || cat; } \
    | sed -n "1,${n}p" | LC_ALL=C cut -d: -f3-
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  --version|-V) echo "$SELF $VERSION"; exit 0 ;;
esac

[ -d "$MD" ] || "$EXPORT" >/dev/null

case "${1:-}" in
  show|--preview)
    f="${2:-}"; [ -n "$f" ] || { usage >&2; exit 1; }
    [ -f "$f" ] || f="$MD/${f#qmd://$COL/}"
    [ -f "$f" ] || { echo "no transcript: $f" >&2; exit 1; }
    if [ "$1" = --preview ]; then
      line="${3:-1}"; start=$((line > 5 ? line - 5 : 1))
      if command -v bat >/dev/null 2>&1; then
        exec bat --paging=never --color=always --style=numbers --language=md -r "$start:" --highlight-line="$line" "$f"
      fi
      exec sed -n "${start},\$p" "$f"
    fi
    if [ -t 1 ] && command -v nvim >/dev/null 2>&1; then
      NVIM_QUERY="${4:-}" exec nvim -R \
        -c "lua vim.treesitter.stop()" -c "syntax enable" -c "set cursorline hlsearch" \
        -c "lua local q = os.getenv('NVIM_QUERY') or ''; q = q:gsub('\\\\', '\\\\\\\\'); vim.fn.setreg('/', '\\\\c\\\\V' .. q)" \
        -c "normal! ${3:-1}zz" "$f"
    fi
    if command -v bat >/dev/null 2>&1; then
      batargs=()
      [ -z "${3:-}" ] || batargs=(-r "$3:" --highlight-line "$3")
      exec bat --paging=auto --language=md ${batargs[@]+"${batargs[@]}"} "$f"
    fi
    if [ -t 1 ] && command -v less >/dev/null 2>&1; then exec less -R "+${3:-1}" "$f"; fi
    exec cat "$f"
    ;;
  export)
    shift; exec "$EXPORT" "$@"
    ;;
  resume)
    f="${2:-}"; [ -f "$f" ] || { usage >&2; exit 1; }
    f="$(cd "$(dirname "$f")" && pwd -P)/$(basename "$f")"
    home="$(cd "$HOME" && pwd -P)"
    case "$f" in
      "$home/.pi/agent/sessions-md/"*) rel="${f#"$home/.pi/agent/sessions-md/"}" ;;
      "$home/.pi/agent/sessions-md-full/"*) rel="${f#"$home/.pi/agent/sessions-md-full/"}" ;;
      *) echo "not an exported session: $f" >&2; exit 1 ;;
    esac
    rel="${rel%.md}"
    jsonl="$HOME/.pi/agent/sessions/$rel.jsonl"
    [ -f "$jsonl" ] || { echo "no session file for $f" >&2; exit 1; }
    cwd=$(sed -n '1s/^_session cwd: \(.*\)_$/\1/p' "$f")
    cd "${cwd:-$PWD}" && exec pi --session "$jsonl"
    ;;
  copy|copy-path)
    f="${2:-}"; [ -f "$f" ] || { usage >&2; exit 1; }
    case "$1" in
      copy) copy_file "$f" ;;
      copy-path) printf %s "$f" | pbcopy ;;
    esac
    ;;
  --rows-v)  # internal: semantic rows for ctrl-r reload
    shift
    refresh=""
    if [ "${1:-}" = "--refresh" ]; then refresh="--refresh"; shift; fi
    semantic_rows "$@" $refresh
    ;;
  -v)  # semantic search — same picker, qmd-ordered results
    shift
    if [ "${1:-}" = "--reindex" ]; then
      "$EXPORT" >/dev/null
      qmd update -c "$COL" >/dev/null
      qmd embed -c "$COL" >&2
      shift
    fi
    parse_flags "$@"
    q="${REST[0]:-}"
    [ -n "$q" ] || { usage >&2; exit 1; }
    if [ $ALL = 1 ]; then limitargs=(--all); else limitargs=(-n "$N"); fi
    distflag=""; if [ $DISTINCT = 1 ]; then distflag=--distinct; fi
    parentflag=""; if [ $PARENTS_ONLY = 1 ]; then parentflag=-p; fi
    rows=$(semantic_rows "$q" ${limitargs[@]+"${limitargs[@]}"} $distflag $parentflag) || true
    [ -n "$rows" ] || { echo "no semantic matches for '$q'" >&2; exit 1; }
    age=$(qmd status 2>/dev/null | sed -n 's/.*Updated: *//p' | head -n1)
    escq=$(printf '%q' "$q")
    limstr=${limitargs[*]+"${limitargs[*]}"}
    fzf_pick "$rows" "$q" \
      "enter: resume · ctrl-o: open · ctrl-t/x: copy file/path · ctrl-/: preview · esc: cancel · ctrl-r: refresh index · index: ${age:-unknown}" \
      "ctrl-r:reload($ESC_BIN --rows-v --refresh $escq $limstr $distflag $parentflag)" \
      "sessions (best match first)"
    ;;
  "")  usage >&2; exit 1 ;;
  *)   # keyword search — rows ordered by match strength, default top 20
    parse_flags "$@"
    q="${REST[0]:-}"
    [ -n "$q" ] || { usage >&2; exit 1; }
    if [ $TR = 1 ]; then
      "$EXPORT" -t >/dev/null
      MD="$HOME/.pi/agent/sessions-md-full"
    else
      "$EXPORT" >/dev/null
    fi
    # rank files by hit count, then list each file's matches in that order
    order=$(rg -i -e "$q" -c --no-messages "$MD" | sort -t: -k2 -rn | sed "s|$MD/||")
    [ -z "$order" ] && { echo "no matches for '$q'" >&2; exit 1; }
    matches=$(rg -i -e "$q" -n --no-messages "$MD" | sed "s|$MD/||")
    # strength = occurrences of the query in the row; ties keep file rank.
    rows=$(idx=0
           for f in $(echo "$order" | cut -d: -f1); do
             idx=$((idx+1))
             age=$(row_age "$f")
             echo "$matches" | grep -F -- "$f:" \
               | sed -E $'s/^([^:]+:[0-9]+):(.{110}).*/\\1:\\2…/' \
               | awk -v age="$age" '
                   { p=$0; sub(/:.*/, "", p)
                     rest=$0; sub(/^[^:]*:/, "", rest)
                     l=rest; sub(/:.*/, "", l)
                     t=rest; sub(/^[0-9]+:/, "", t)
                     gsub(/\t/, " ", t)
                     print p "\t" l "\t" age "\t" t }' \
               | labelize 0 "$q" "-$(printf %s "$HOME" | sed 's|/|-|g')" "$PARENTS_ONLY" "$idx" || true
           done)
    [ -n "$rows" ] || { echo "no matches for '$q'" >&2; exit 1; }
    [ $ALL = 1 ] && N=999999
    rows=$(echo "$rows" | LC_ALL=C sort | { [ $DISTINCT = 1 ] && distinct_rows || cat; } | sed -n "1,${N}p" | LC_ALL=C cut -d: -f3-)
    fzf_pick "$rows" "$q" "enter: resume · ctrl-o: open · ctrl-t/x: copy file/path · ctrl-/: preview · esc: cancel" "" "sessions"
    ;;
esac
