#!/usr/bin/env bash
# pi-search-maintenance: nightly refresh of the pi-search semantic index.
# 1. incremental export (default lean corpus)
# 2. prune exported markdown whose source session was deleted
# 3. qmd re-index + embed new/changed chunks
set -euo pipefail

SRC="$HOME/.pi/agent/sessions"
MD="$HOME/.pi/agent/sessions-md"
EXPORT="$(dirname "$0")/pi-export-history"
[ -x "$EXPORT" ] || EXPORT="$(command -v pi-export-history || echo "$HOME/.local/bin/pi-export-history")"
"$EXPORT" >/dev/null

# remove exported .md files with no matching .jsonl (prunes forks/run dirs too)
find "$MD" -name '*.md' -print0 | while IFS= read -r -d '' m; do
  rel="${m#"$MD"/}"; rel="${rel%.md}.jsonl"
  [ -f "$SRC/$rel" ] || rm -f "$m"
done
find "$MD" -mindepth 1 -type d -empty -delete 2>/dev/null || true
qmd update -c pi-history >/dev/null
qmd embed -c pi-history
